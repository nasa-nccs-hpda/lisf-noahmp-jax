# No secrets are used. Environment variables read by tests and tools (paths are site-specific; examples only):
# LISF_RUN=/path/to/lisf_run        raw LDT inputs and reference files for tests/test_ldt.py (skipped when absent)
# LIS_BIN=/path/to/LIS_mp50_dump    instrumented Fortran LIS used by tools/replay/variants50.py
# MPVER=50                          Noah-MP version for tools/replay/replay_mp50.py (36, 401 or 50)
# VAR_DAY, VAR_MONTH                dump selection for tools/replay/variants50.py
# JAXDUMP_SNOWONLY=1, JAXDUMP_MAXSTEP=n   switches read by the instrumented Fortran LIS
